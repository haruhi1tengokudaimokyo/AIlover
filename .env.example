# ===== 必填：阿里云百炼（DashScope）密钥 =====
# 在 https://bailian.console.aliyun.com/ 获取 API-KEY
API_KEY=sk-在这里填入你的百炼API-KEY

# 百炼 OpenAI 兼容接口地址（一般不用改）
API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 百炼语音 WebSocket 地址（ASR 语音识别 + TTS 语音合成共用）
WSS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# ===== 可选：模型与生成参数 =====
MODEL=deepseek-v3.2
LLM_TEMPERATURE=0.95
LLM_TOP_P=0.9
LLM_FREQUENCY_PENALTY=0.4
LLM_PRESENCE_PENALTY=0.3

# ===== 可选：默认音色 =====
# 关闭语音后不连接语音服务；界面也可单次切换纯文字
TTS_ENABLED=true
TTS_MODEL=cosyvoice-v3-flash
# 使用其他平台的聊天模型时，可单独填写百炼语音密钥
TTS_API_KEY=
# 全局默认音色（角色未单独配置时使用）
TTS_VOICE=longanyang
# 语速 / 音调
TTS_RATE=1.0
TTS_PITCH=1.0

# ===== 可选：丛雨专属音色 =====
# 在百炼控制台「声音复刻」上传一段丛雨语音样本，得到音色 ID 后填在这里，
# 然后重新运行：python manage.py seed_murasame
MURASAME_VOICE=

# ===== 可选：《王様恋愛》角色音色 =====
# 参考音频已备好：backend/seed_assets/hika/voice_ref.opus（绯华，CV：春乃いろは）
#               backend/seed_assets/ayame/voice_ref.opus（菖蒲，CV：桃山いおん）
#               backend/seed_assets/mugi/voice_ref.opus（麦；本地提取）
# 上传到百炼控制台「声音复刻」得到音色 ID 后填在这里，
# 然后重新运行：python manage.py seed_ousama
HIKA_VOICE=
AYAME_VOICE=
MUGI_VOICE=

# ===== 可选：《天津罪》水无月萤音色 =====
# 原作日语参考用于后续适配，不代表已生成中文克隆模型。
# 留空时使用现有通用中文音色；真实角色音色适配完成后填入可用的服务ID。
# 然后运行：python backend/manage.py seed_amatsutsumi
HOTARU_VOICE=

# ===== 可选：独立嵌入服务（更换聊天平台后，仍可用百炼构建原作台词索引） =====
# 留空则沿用 API_KEY / API_BASE；构建和检索必须使用相同模型与维度
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# Story-aware RAG (local sparse search by default; explicit dense opt-in)
ROLEPLAY_RAG_MODE=story
STORY_RETRIEVAL_STRATEGY=hybrid
STORY_DENSE_ENABLED=false
STORY_DENSE_MAX_DISTANCE=0.8
STORY_CONTEXT_BUDGET=16000
ROLEPLAY_IDENTITY_MODE=real_user
ROLEPLAY_DEBUG_TRACE=false
# STORY_DATA_DIR=D:/AIlover/extracted/story_builds/phase1-v4
# Frontend dev server only: VITE_ROLEPLAY_DEBUG=true
# Structured memory requires migration 0011. Set legacy for summary fallback.
MEMORY_MODE=structured
# Streamed TTS sentence batching; false restores token forwarding.
TTS_SENTENCE_BUFFER=true
TTS_SENTENCE_MIN=4
TTS_SENTENCE_MAX=80
TTS_QUEUE_LIMIT=32
TTS_TIMEOUT_SECONDS=90

# Trained character services (install with scripts/install_trained_models.py).
# Enable after the GPU text + four dedicated speech services are running.
CHARACTER_MODELS_ENABLED=false
# CHARACTER_MODELS_MANIFEST=D:/AIlover/runtime/manifest.json
CHARACTER_MODEL_API_KEY=local
# FFmpeg converts GPT-SoVITS WAV to the MP3 expected by the browser player.
# Leave empty to use the bundled imageio-ffmpeg executable.
FFMPEG_BIN=
